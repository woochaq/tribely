<% if user_signed_in? %>
  <p>Welcome back, <%= current_user.email %>!</p>
  <%= button_to "Sign Out", destroy_user_session_path, method: :delete, data: { turbo: false } %>
  <% else %>
  <p>Welcome, Guest!</p>
  <%= link_to "Sign In", new_user_session_path %>
<% end %>

<h1 class="text-3xl font-bold underline">
  Hello world!
</h1>
